# Bu dosyanın adını ".env" yapın ve değerleri değiştirin.
# Yerelde denerken hiçbirini değiştirmeniz gerekmez; yayına alırken HEPSİNİ değiştirin.

# Veritabanı şifresi
DB_PASSWORD=pomp

# Giriş anahtarlarını imzalayan gizli anahtar: en az 32 karakter, rastgele olmalı.
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-metin-yazin

# Sunucu internete açıldığında dışarıdan erişilen adresi (örn. https://api.alanadiniz.com)
PUBLIC_URL=

# Yayında "production" yapın
NODE_ENV=development
