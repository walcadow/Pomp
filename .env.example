# Bu dosyanın adını ".env" yapın ve değerleri değiştirin.
# Yerelde denerken hiçbirini değiştirmeniz gerekmez; yayına alırken HEPSİNİ değiştirin.

# Veritabanı şifresi
DB_PASSWORD=pomp

# Giriş anahtarlarını imzalayan gizli anahtar: en az 32 karakter, rastgele olmalı.
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-metin-yazin

# Sunucu internete açıldığında dışarıdan erişilen adresi (örn. https://api.alanadiniz.com)
PUBLIC_URL=

# Yayında "production" yapın
NODE_ENV=development

# Yönetici paneli şifresi (http://localhost:3000/admin)
# Boş bırakılırsa panel kapalıdır. Uzun ve tahmin edilmesi zor bir şifre yazın.
ADMIN_PASSWORD=

# E-posta gönderimi (ayrıntılar: EPOSTA_KURULUM.md)
# SMTP_HOST boşsa e-postalar gönderilmez, http://localhost:3000/dev/emails sayfasında görünür.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
